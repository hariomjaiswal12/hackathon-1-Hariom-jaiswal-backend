# ==============================================================================
# TXOTX OS Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your deployment environment.
# Never commit real secrets or credentials to source control.

# Application Environment (development, test, production)
NODE_ENV=development

# HTTP Server Port (default: 5000)
PORT=5000

# MongoDB Connection String (e.g. mongodb://127.0.0.1:27017/txotx or mongodb+srv://...)
# Required in production.
MONGODB_URI=mongodb://127.0.0.1:27017/txotx

# JSON Web Token Secret (used for signing access tokens)
# Minimum 16 characters required in production. Use a cryptographically secure random string.
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars!

# JWT Expiration Duration (e.g. 15m, 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Frontend Client URL / Allowed CORS Origins
# Comma-separated list of origins permitted to access the API.
# Wildcard '*' is strictly prohibited in production.
CLIENT_URL=https://hackathon-1-hariom-jaiswal-frontend.vercel.app,http://localhost:5173

# ==============================================================================
# Background Scheduler & Automated Jobs
# ==============================================================================
# Master switch for all scheduled jobs (true/false)
JOBS_ENABLED=false

# Booking Reminder Job (sends notifications prior to reservation time)
BOOKING_REMINDER_ENABLED=false
BOOKING_REMINDER_MINUTES=120

# Waitlist Expiry Job (expires stale waitlist requests past the booking date)
WAITLIST_EXPIRY_ENABLED=false
WAITLIST_EXPIRY_HOURS=24

# Booking Cleanup Job (transitions past unfulfilled bookings)
BOOKING_CLEANUP_ENABLED=false

# No-show blacklist
# A customer is restricted from new online reservations after this many no-shows.
NO_SHOW_BLACKLIST_THRESHOLD=3

# Shared secret for signed booking-channel webhooks. Leave empty until a channel is configured.
# Never commit a real secret.
INTEGRATION_WEBHOOK_SECRET=

# Retell signs webhooks with the API key that has the webhook badge.
# RETELL_WEBHOOK_SECRET overrides that key when a separate signing secret is issued.
# RETELL_AGENT_ID is optional and must look like agent_... when set.
# Leave empty until Retell is configured. Never commit a real key.
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
RETELL_AGENT_ID=

# WhatsApp Cloud API. Leave empty until Meta is configured. Never commit real tokens.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
